# Supabase (create a project at https://supabase.com, then Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the MCP/API-key auth path.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app origin (used for OG tags and generated artifact URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of vanity base domains this deployment serves.
# Defaults to every claimable domain in the portfolio (lib/domains.ts).
NEXT_PUBLIC_VANITY_DOMAINS=vault.cool,agentvault.cloud,cleon.wiki,inkbound.ink,claudedamnit.com,cleon.casa,cleon.city,tinderforai.com,onlywizards.website,hypervault.store,ralphy.website,permaclaw.com

# Encrypts secrets at rest (AES-256-GCM): stored LLM backend API keys, MCP
# server auth headers, and MCP OAuth grants (access/refresh tokens). Optional —
# when unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY — but set it
# explicitly so rotating the service role key doesn't orphan stored secrets.
HYPERVAULT_KEY_SECRET=

# --- Deep memory (optional): stenographer sidecar --------------------------
# GraphRAG recall across all your conversations, powered by a stenographer
# daemon (github.com/johnnyclem/stenographer) running as a separate process.
# Leave both unset to hide the feature entirely. See docs/chat-context.md.
#
# Base URL of the sidecar's REST API (e.g. http://stenographer:8787).
STENOGRAPHER_URL=
# JSONL transcript file this app appends chat turns to and the sidecar tails.
# Only works when both share a filesystem (self-hosted / docker-compose) —
# leave unset on Vercel and run scripts/stenographer-export.mjs instead.
STENOGRAPHER_LOG_PATH=

# --- GitHub star → weekly invite codes (optional) --------------------------
# Stargazers of the repo get a fresh single-use invite code emailed every
# Monday. Wire up all four to turn it on; leave them unset and the loop stays
# inert (nothing is minted or sent). See docs/github-star-invites.md.
#
# owner/repo whose stars trigger invites (defaults to johnnyclem/hypervault-web).
GITHUB_STAR_REPO=johnnyclem/hypervault-web
# Secret shared with the repo webhook (Settings → Webhooks → Stars event).
# Verifies X-Hub-Signature-256 on POST /api/github/webhook.
GITHUB_WEBHOOK_SECRET=
# Optional PAT — lifts the anon GitHub API rate limit for the weekly sync and
# is required for a private repo. Needs only public/read access.
GITHUB_TOKEN=
# Shared secret guarding POST/GET /api/cron/star-invites. Vercel Cron sends it
# as a bearer token automatically when set here.
CRON_SECRET=
# Resend API key (https://resend.com) — the only supported email provider.
# Unset = invite emails are skipped (codes aren't minted).
RESEND_API_KEY=
# From address for invite emails. Must be a verified Resend sender/domain.
INVITE_FROM_EMAIL=HyperVault <invites@hypervault.store>

# --- Polytician (optional): local embedding reranker -----------------------
# Base URL of a Polytician Python ML sidecar's /embed API
# (github.com/johnnyclem/polytician). When set, users without a cloud embedding
# backend get their lexical wiki recall reranked with local embeddings — recall
# reports recall_mode: "hybrid-local". Leave unset to hide the feature.
# Note: this is the *inbound* direction (HyperVault → Polytician). A Polytician
# server syncing INTO HyperVault needs no env var here — it just points its
# AgentVault config at this deployment with an hv_ API key. See docs/polytician.md.
POLYTICIAN_SIDECAR_URL=
